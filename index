<style>
/* Layout: one centered column. Loader card first, quiz and results cards swap in place. Dark look kept from the user's original page. */
:root{
  color-scheme:dark;
  --bg:#0b1020;--bg-glow:#172746;
  --panel:rgba(18,26,45,.96);--panel-2:#151f34;--panel-3:#17233a;
  --line:#2b3955;--line-2:#34425e;
  --text:#edf3ff;--muted:#aab8d0;--soft:#e1e8f3;
  --accent:#7cafff;--accent-2:#b7d3ff;--accent-fill:#6fa5ff;--accent-ink:#08152b;
  --good:#37c991;--good-bg:#10382f;--good-line:#237d61;--good-ink:#05251b;
  --bad:#ff7c87;--bad-bg:#3c202b;--bad-line:#85434f;--bad-ink:#2c0c12;
  --font:system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;
  --mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
}
*{box-sizing:border-box}
body{
  margin:0;min-height:100vh;
  background:radial-gradient(ellipse at top,var(--bg-glow) 0%,var(--bg) 55%) var(--bg);
  color:var(--text);font:16px/1.5 var(--font);
  padding-left:max(16px,env(safe-area-inset-left,0px));
  padding-right:max(16px,env(safe-area-inset-right,0px));
  padding-block:24px 48px;
}
main{width:min(850px,100%);margin:0 auto}
header{display:flex;justify-content:space-between;align-items:center;gap:12px 16px;margin:4px 0 20px;flex-wrap:wrap}
h1{font-size:clamp(1.25rem,3vw,1.8rem);margin:0;letter-spacing:-.03em;text-wrap:balance}
h2{text-wrap:balance}
.sub{color:var(--muted);font-size:.92rem;margin-top:4px}
.head-right{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.pill{border:1px solid var(--line);background:#121d32;border-radius:999px;padding:7px 12px;color:var(--accent-2);white-space:nowrap;font-size:.88rem}
.progress-wrap{height:7px;background:#202c43;border-radius:99px;overflow:hidden;margin:0 0 20px}
#progress{height:100%;width:0;background:linear-gradient(90deg,#5f9bff,#75d6c2);transition:width .2s}
.card{background:var(--panel);border:1px solid var(--line);border-radius:20px;padding:clamp(18px,4vw,30px);box-shadow:0 18px 50px #0002}
.meta{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:16px;color:var(--muted);font-size:.9rem;flex-wrap:wrap}
#question{font-size:clamp(1.15rem,3vw,1.48rem);font-weight:650;line-height:1.4;margin:0 0 22px;white-space:pre-wrap;overflow-wrap:anywhere}
.options{display:grid;gap:11px}
.option{width:100%;min-width:0;display:flex;align-items:flex-start;gap:13px;text-align:left;padding:14px 15px;border:1px solid var(--line-2);border-radius:13px;background:var(--panel-2);color:var(--text);font:inherit;cursor:pointer;transition:border-color .15s,background .15s,transform .1s}
.option>span:last-child{min-width:0;overflow-wrap:anywhere}
.option:hover:not(:disabled){border-color:var(--accent);background:#1a2944}
.option:active:not(:disabled){transform:scale(.995)}
.letter{flex:0 0 29px;height:29px;border:1px solid #465775;border-radius:8px;display:grid;place-items:center;color:var(--accent-2);font-weight:750;font-size:.9rem}
.option.correct{background:var(--good-bg);border-color:var(--good)}
.option.correct .letter{background:var(--good);border-color:var(--good);color:var(--good-ink)}
.option.wrong{background:var(--bad-bg);border-color:var(--bad)}
.option.wrong .letter{background:var(--bad);border-color:var(--bad);color:var(--bad-ink)}
.option:disabled{cursor:default}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
#feedback{margin-top:18px;border-radius:12px;padding:13px 15px}
#feedback.good{background:var(--good-bg);border:1px solid var(--good-line)}
#feedback.bad{background:var(--bad-bg);border:1px solid var(--bad-line)}
.feedback-title{font-weight:750;margin-bottom:3px}
.feedback-detail{color:var(--soft);overflow-wrap:anywhere}
.controls{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-top:22px;flex-wrap:wrap}
.left-controls,.right-controls{display:flex;gap:9px;flex-wrap:wrap}
button.action{border:1px solid var(--line);background:#1a2740;color:var(--text);border-radius:11px;padding:10px 15px;font:600 .95rem var(--font);cursor:pointer}
button.action:hover:not(:disabled){border-color:var(--accent)}
button.action.primary{background:var(--accent-fill);color:var(--accent-ink);border-color:var(--accent-fill)}
button.action.small{padding:7px 12px;font-size:.85rem}
button.action:disabled{opacity:.35;cursor:not-allowed}
.stats{display:flex;gap:16px;flex-wrap:wrap;color:var(--muted);font-size:.9rem;margin-top:18px;font-variant-numeric:tabular-nums}
.stats strong{color:var(--text)}
.summary-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:20px 0}
.statbox{padding:14px;background:var(--panel-3);border:1px solid var(--line);border-radius:13px;min-width:0}
.statbox strong{display:block;font-size:1.5rem;font-variant-numeric:tabular-nums}
.statbox span{color:var(--muted);font-size:.85rem}
.review-list{display:grid;gap:8px;margin-top:18px}
.review-item{padding:12px;border:1px solid var(--line);border-radius:10px;background:var(--panel-2);overflow-wrap:anywhere}
.review-item .q{font-weight:650;margin-bottom:6px}
.review-item .yours{color:var(--bad)}
.review-item .right{color:var(--good)}
.note{color:var(--muted);font-size:.82rem;text-align:center;margin-top:16px}

/* loader */
.drop{border:1.5px dashed #465775;border-radius:16px;padding:clamp(20px,5vw,34px);text-align:center;background:var(--panel-2);transition:border-color .15s,background .15s}
.drop.over{border-color:var(--accent);background:#1a2944}
.drop p{margin:0 0 14px;color:var(--soft)}
.drop .hint{color:var(--muted);font-size:.88rem;margin:12px 0 0}
.or{display:flex;align-items:center;gap:12px;color:var(--muted);font-size:.85rem;margin:20px 0}
.or::before,.or::after{content:"";flex:1;height:1px;background:var(--line)}
textarea{width:100%;min-height:190px;resize:vertical;background:#0f172a;color:var(--text);border:1px solid var(--line-2);border-radius:12px;padding:12px 14px;font:.86rem/1.55 var(--mono)}
textarea::placeholder{color:#6f7f9b}
.format{margin-top:18px;border:1px solid var(--line);border-radius:12px;background:var(--panel-3);padding:12px 14px}
.format summary{cursor:pointer;color:var(--accent-2);font-weight:600;font-size:.9rem}
.format pre{margin:10px 0 0;font:.84rem/1.55 var(--mono);color:var(--soft);overflow-x:auto;white-space:pre}
.format ul{margin:10px 0 0;padding-left:18px;color:var(--muted);font-size:.86rem}
#loadMsg{margin-top:14px;font-size:.9rem;min-height:1.4em}
#loadMsg.err{color:var(--bad)}
#loadMsg.ok{color:var(--good)}
@media(max-width:520px){
  body{padding-block:15px 30px}
  .card{border-radius:15px}
  .summary-grid{grid-template-columns:1fr 1fr}
  .pill{font-size:.78rem}
  .controls{align-items:stretch}
  .left-controls,.right-controls{width:100%}
  .controls button{flex:1}
}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}
</style>

<main>
<header>
  <div><h1 id="appTitle">Sensory MCQs 2</h1><div class="sub" id="appSub">Questions 57–112 · answers revealed immediately</div></div>
